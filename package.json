{
  "name": "pi-mlx-vlm",
  "version": "0.1.0",
  "description": "Pi provider for local MLX models via mlx-vlm, with MTP, DFlash and DSpark speculative decoding, and the pi-mlx CLI to pull models",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "mlx",
    "mlx-vlm",
    "speculative-decoding",
    "dflash",
    "mtp",
    "ollama"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "e2e": "node test/e2e.ts",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/bench.ts",
    "postinstall": "node -e \"const f=require('fs'),p=require('path'),d=p.join(require('os').homedir(),'.local','bin');try{f.mkdirSync(d,{recursive:true});f.symlinkSync(p.resolve('bin/pi-mlx.mjs'),p.join(d,'pi-mlx'))}catch{}\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "pi-mlx": "bin/pi-mlx.mjs"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "files": [
    "src",
    "bin",
    "catalog.json",
    "README.md"
  ],
  "repository": "github:tctsung/pi-mlx-vlm"
}
